# Copy to .env.preview or .env.production and supply that environment's credentials.
# Existing process environment variables take precedence. Keep real files private.
# Install Microsoft ODBC Driver 18 for SQL Server separately.
EMS_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=tcp:<server>.database.windows.net,1433;DATABASE=<database>;UID=<runtime-user>;PWD={<runtime-password>};Encrypt=yes;TrustServerCertificate=no;
# Azure production/preview setup: development-plans/AZURE_SQL_SETUP_GUIDE.md
# Launch preview with `uv run ems`; launch production with `uv run ems production`.
# Azure uses separate database-contained users, Encrypt=yes and TrustServerCertificate=no.
